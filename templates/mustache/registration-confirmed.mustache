{{! 
  @template theme_boost/registration-confirmed
  MindStormer Global Academy (MSA-500) Post-Registration Account Confirmed Welcome Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Confirmed | MindStormer Global Academy</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    html, body {
      background-color: #F8FAFC !important;
      min-height: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      font-family: 'Inter', sans-serif;
    }
    h1, h2, h3, .font-heading {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(6px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>
  {{{ output.standard_head_html }}}
</head>
<body class="bg-[#F8FAFC] text-slate-800 antialiased min-h-[100dvh] flex flex-col justify-between overflow-x-hidden selection:bg-emerald-600 selection:text-white">
  {{{ output.standard_top_of_body_html }}}

  <!-- WCAG 2.1 AA Skip to Main Content Bypass Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-[#1D4ED8] focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold focus:shadow-lg focus:outline-none">Skip to main content</a>

  <!-- Header Navigation Landmark -->
  <header role="banner" class="w-full bg-white border-b border-slate-200/80 px-4 sm:px-6 py-3.5 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="{{{ config.wwwroot }}}/index.html" class="flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded-xl min-h-[48px] py-1" aria-label="MindStormer Global Academy Home">
        <div class="w-10 h-10 rounded-xl bg-[#0B0F19] flex items-center justify-center text-white font-black text-sm tracking-tight border border-slate-800 shadow-sm flex-shrink-0">MS</div>
        <div class="flex flex-col">
          <span class="text-sm sm:text-base font-black tracking-tight text-slate-900 leading-none whitespace-nowrap font-heading">MAYND STORMIR</span>
          <span class="text-[10px] font-extrabold tracking-wider text-blue-600 uppercase mt-0.5">ACADEMY</span>
        </div>
      </a>
      <div class="flex items-center gap-3">
        <a href="{{{ config.wwwroot }}}/my/" class="text-xs font-bold text-slate-700 hover:text-emerald-600 transition flex items-center gap-1 min-h-[48px] py-1 px-2 rounded-lg">
          My Dashboard →
        </a>
      </div>
    </div>
  </header>

  <!-- Main Confirmation Container Landmark -->
  <main id="main-content" role="main" class="flex-1 flex items-center justify-center p-4 sm:p-6 md:p-8 w-full">
    <div class="msa-page-wrapper w-full max-w-[500px] bg-white border border-slate-100 rounded-3xl shadow-2xl shadow-slate-200/50 p-8 sm:p-10 text-center relative overflow-hidden">
      
      <!-- HERO POD: Soft-Tinted Squircle Container -->
      <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center mx-auto mb-6 shadow-sm">
        <!-- Lucide: shield-check from icones.js.org -->
        <svg class="w-8 h-8 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>

      <!-- STATUS BADGE -->
      <div class="mb-3">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-[11px] font-heading font-black tracking-wider uppercase bg-emerald-50 text-emerald-700 border border-emerald-200/60">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          Registration Verified
        </span>
      </div>

      <!-- TITLE & GREETING -->
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight text-center font-heading mb-1">
        Account Confirmed!
      </h1>
      <p class="text-base font-bold text-emerald-700 font-heading mb-2">
        Welcome to the Academy{{#fullname}}, {{fullname}}{{/fullname}}!
      </p>
      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mb-6 font-body">
        Your official student profile has been certified and activated. Your academic curriculum tracks, virtual laboratory workspaces, and Continuous Assessment standing are ready.
      </p>

      <!-- NEXT STEPS ROADMAP BOX -->
      <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4 text-left mb-6 text-xs text-slate-600 space-y-2.5 font-body">
        <div class="flex items-center gap-2 font-heading font-bold text-slate-800 uppercase tracking-wider text-[11px]">
          <!-- Lucide: check-circle-2 from icones.js.org -->
          <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          <span>Your Academy Workspace is Configured:</span>
        </div>
        <ul class="space-y-2.5 pl-1">
          <li class="flex items-start gap-2.5">
            <!-- Lucide: book-open from icones.js.org -->
            <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
            <span><strong>15 NERDC Subjects:</strong> Enrolled in your accredited academic disciplines.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <!-- Lucide: target from icones.js.org -->
            <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
            <span><strong>CA Assessment Engine:</strong> 40% Continuous Assessment tracking initialized.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <!-- Lucide: users from icones.js.org -->
            <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span><strong>Guardian Transparency:</strong> Linked to the Parent Portal for weekly transcripts.</span>
          </li>
        </ul>
      </div>

      <!-- PRIMARY ACTION BUTTON -->
      <a href="{{{ continueurl }}}{{#continueurl}}{{/continueurl}}{{^continueurl}}{{{ config.wwwroot }}}/my/{{/continueurl}}" class="w-full min-h-[48px] py-3.5 px-5 rounded-xl font-bold text-sm text-white shadow-lg shadow-emerald-500/20 bg-emerald-600 hover:bg-emerald-700 transition active:scale-[0.99] flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 font-heading tracking-wide uppercase">
        <span>Go to My Dashboard</span>
        <!-- Lucide: arrow-right from icones.js.org -->
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </a>

      <!-- SECONDARY LINK -->
      <a href="{{{ config.wwwroot }}}/index.html#framework" class="text-xs font-bold text-slate-600 hover:text-slate-900 text-center block mt-3 py-2 min-h-[44px] transition">
        View Curriculum Framework →
      </a>

    </div>
  </main>

  <!-- INSTITUTIONAL FOOTER -->
  <footer role="contentinfo" class="w-full bg-[#0B1120] text-slate-400 text-xs py-4 text-center font-medium mt-auto border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

  {{{ output.standard_end_of_body_html }}}
</body>
</html>
