{{! 
  @template theme_boost/parent_signup
  MindStormer Global Academy (MSA-500) Guardian Registration Template
}}
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #F8FAFC;
  }
  .card-tactile {
    background: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-bottom-width: 5px;
  }
  .btn-3d-emerald {
    background-color: #059669;
    box-shadow: 0 4px 0 #047857;
    transition: all 0.2s ease;
  }
  .btn-3d-emerald:hover {
    background-color: #047857;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(5,150,105,0.3), 0 4px 0 #065F46;
  }
  .btn-3d-emerald:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 #065F46;
  }

  /* Target dynamic Moodle Form elements */
  .msa-guardian-form label {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: #334155;
    text-transform: uppercase;
    margin-bottom: 0.375rem;
  }
  .msa-guardian-form input[type="text"],
  .msa-guardian-form input[type="email"],
  .msa-guardian-form input[type="password"] {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border-radius: 0.75rem;
    border: 2px solid #E2E8F0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1E293B;
    outline: none;
    transition: border-color 0.2s ease;
    margin-bottom: 0.75rem;
  }
  .msa-guardian-form input:focus {
    border-color: #059669;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);
  }
</style>

<div class="msa-corporate-theme bg-[#F8FAFC] text-slate-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- Header Navigation -->
  <header class="bg-white border-b-2 border-slate-100 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-[#0F172A] to-blue-900 rounded-xl flex items-center justify-center text-white font-black text-lg border border-blue-500/20">MS</div>
        <span class="font-black text-base text-[#0F172A]">MAYND STORMIR <span class="text-emerald-600">GUARDIAN PORTAL</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}/login/index.php?role=parent" class="text-xs font-bold text-slate-600 hover:text-emerald-600 transition-colors">Already registered? Log in →</a>
    </div>
  </header>

  <!-- Parent Registration Main Form -->
  <main class="flex-1 flex items-center justify-center p-4 py-12">
    <div class="w-full max-w-lg card-tactile rounded-2xl p-8 shadow-xl">
      <div class="text-center mb-8">
        <div class="inline-flex p-3 bg-emerald-50 text-emerald-600 rounded-xl font-bold text-2xl mb-3">🛡️</div>
        <h1 class="text-2xl font-black text-[#0F172A]">Register Guardian Account</h1>
        <p class="text-xs font-semibold text-slate-500 mt-1">Link your account to track your child's continuous assessments</p>
      </div>

      {{#error}}
      <div class="flex items-center gap-2 p-3 mb-4 text-xs font-bold text-red-700 bg-red-50 border border-red-200 rounded-xl" role="alert">
        <span>⚠️</span> <span>{{error}}</span>
      </div>
      {{/error}}

      <form action="{{{ signupurl }}}" method="post" id="signup" class="space-y-4 msa-guardian-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="account_type" value="parent">

        <div>
          <label for="guardian_fullname" class="block text-xs font-extrabold text-slate-700 uppercase mb-1.5">Full Name</label>
          <input type="text" id="guardian_fullname" name="fullname" required placeholder="e.g. Mr. O. Olamiposi">
        </div>

        <div>
          <label for="guardian_email" class="block text-xs font-extrabold text-slate-700 uppercase mb-1.5">Guardian Email Address</label>
          <input type="email" id="guardian_email" name="email" required placeholder="parent@mindstormer.com">
        </div>

        <div>
          <label for="student_link_id" class="block text-xs font-extrabold text-slate-700 uppercase mb-1.5">Link Student ID</label>
          <input type="text" id="student_link_id" name="student_id" required placeholder="Enter student code (e.g. STU-2026-8812)">
        </div>

        <div class="relative">
          <label for="guardian_password" class="block text-xs font-extrabold text-slate-700 uppercase mb-1.5">Password</label>
          <input type="password" id="guardian_password" name="password" required placeholder="Minimum 8 characters" class="pr-10">
          <button type="button" data-toggle-password="guardian_password" class="absolute right-3 top-[34px] text-slate-400 hover:text-slate-600 focus:outline-none p-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </button>
        </div>

        <button type="submit" class="w-full btn-3d-emerald text-white font-black py-3.5 rounded-xl text-sm uppercase tracking-wider mt-2">
          Create Guardian Account 🛡️
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-slate-100 text-center text-xs font-bold text-slate-500">
        Student Account? <a href="{{{ config.wwwroot }}}/login/signup.php" class="text-blue-600 hover:underline">Register Student Account</a>
      </div>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const toggleButtons = document.querySelectorAll('[data-toggle-password]');
  toggleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-toggle-password');
      const input = document.getElementById(targetId);
      if (input) {
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        btn.classList.toggle('text-emerald-600', isPassword);
        btn.classList.toggle('text-slate-400', !isPassword);
      }
    });
  });
});
</script>