{{! 
  @template theme_boost/parent_signup
  MindStormer Global Academy (MSA-500) Premium Guardian Registration Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guardian Registration | MindStormer Academy</title>
  <style>
    html, body {
      background-color: #F8FAFC !important;
      margin: 0;
      padding: 0;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-tactile {
      background: #FFFFFF;
      border: 2px solid #E2E8F0;
      border-bottom-width: 6px;
      box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
    }
    .btn-3d-emerald {
      background-color: #059669;
      box-shadow: 0 4px 0 #047857;
      transition: all 0.15s ease;
    }
    .btn-3d-emerald:hover {
      background-color: #047857;
      transform: translateY(-1px);
      box-shadow: 0 6px 14px rgba(5,150,105,0.25), 0 4px 0 #065F46;
    }
    .btn-3d-emerald:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #065F46;
    }
    .msa-form-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 800;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.375rem;
    }
    .msa-input {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 0.875rem;
      border: 2px solid #CBD5E1;
      font-size: 0.875rem;
      font-weight: 600;
      color: #0F172A;
      background-color: #FFFFFF;
      outline: none;
      transition: all 0.2s ease;
    }
    .msa-input:focus {
      border-color: #059669;
      box-shadow: 0 0 0 3.5px rgba(5, 150, 105, 0.12);
    }
    .msa-select-custom {
      appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748B' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 1rem center;
      background-size: 1.1em;
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col justify-between font-['Plus_Jakarta_Sans']">

<div class="msa-page-wrapper flex-1 flex flex-col justify-between">

  <!-- Header -->
  <header class="bg-white border-b-2 border-slate-100 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-[#0F172A] to-blue-900 rounded-xl flex items-center justify-center text-white font-black text-lg border border-blue-500/20">MS</div>
        <span class="font-black text-base text-[#0F172A]">MAYND STORMIR <span class="text-emerald-600">GUARDIAN PORTAL</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}/login/index.php?role=parent" class="text-xs font-bold text-slate-600 hover:text-emerald-600 transition-colors">Already registered? Log in →</a>
    </div>
  </header>

  <!-- Form Section -->
  <main class="flex-1 flex items-center justify-center p-4 py-10">
    <div class="w-full max-w-2xl card-tactile rounded-3xl p-6 sm:p-10">
      
      <div class="text-center mb-8">
        <div class="inline-flex p-3 bg-emerald-50 text-emerald-600 rounded-2xl font-bold text-3xl mb-3 shadow-inner">🛡️</div>
        <h1 class="text-2xl sm:text-3xl font-black text-[#0F172A] tracking-tight">Register Guardian Account</h1>
        <p class="text-xs sm:text-sm font-semibold text-slate-400 mt-1">Connect directly to track and monitor your ward's continuous assessment</p>
      </div>

      {{#error}}
      <div class="flex items-center gap-2 p-3.5 mb-6 text-xs font-bold text-red-700 bg-red-50 border-2 border-red-200 rounded-xl" role="alert">
        <span>⚠️</span> <span>{{error}}</span>
      </div>
      {{/error}}

      <form action="{{{ signupurl }}}" method="post" id="signup" class="space-y-5">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="account_type" value="parent">

        <!-- Grid: Guardian Name & Email -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4">
          <div>
            <label for="guardian_fullname" class="msa-form-label">Full Name</label>
            <input type="text" id="guardian_fullname" name="fullname" required placeholder="e.g. Dr. / Mr. Olamiposi" class="msa-input">
          </div>
          <div>
            <label for="guardian_email" class="msa-form-label">Guardian Email</label>
            <input type="email" id="guardian_email" name="email" required placeholder="parent@mindstormer.com" class="msa-input">
          </div>
        </div>

        <!-- Password Field with Dynamic Checklist -->
        <div class="relative">
          <label for="guardian_password" class="msa-form-label">Create Password</label>
          <div class="relative">
            <input type="password" id="guardian_password" name="password" required placeholder="Enter strong password" class="msa-input pr-11">
            <button type="button" data-toggle-password="guardian_password" class="absolute right-3.5 top-[13px] text-slate-400 hover:text-slate-600 focus:outline-none p-1 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>

          <!-- Dynamic Real-Time Password Checklist -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-2.5">
            <div id="rule-length" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-400 text-[11px] font-bold border border-slate-200 transition-colors">
              <span class="status-icon">○</span> 8+ Chars
            </div>
            <div id="rule-upper" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-400 text-[11px] font-bold border border-slate-200 transition-colors">
              <span class="status-icon">○</span> 1 Uppercase
            </div>
            <div id="rule-num" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-400 text-[11px] font-bold border border-slate-200 transition-colors">
              <span class="status-icon">○</span> 1 Number
            </div>
            <div id="rule-spec" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-400 text-[11px] font-bold border border-slate-200 transition-colors">
              <span class="status-icon">○</span> 1 Symbol (*,-,#)
            </div>
          </div>
        </div>

        <!-- Grid: Student Link ID, City, and Country -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-4 gap-y-4">
          <div>
            <label for="student_link_id" class="msa-form-label">Link Student ID</label>
            <input type="text" id="student_link_id" name="student_id" required placeholder="STU-2026-8812" class="msa-input">
          </div>
          <div>
            <label for="city" class="msa-form-label">City / Town</label>
            <input type="text" id="city" name="city" placeholder="Lagos" class="msa-input">
          </div>
          <div>
            <label for="country" class="msa-form-label">Country</label>
            <select id="country" name="country" class="msa-input msa-select-custom cursor-pointer">
              <option value="NG" selected>Nigeria</option>
              <option value="GH">Ghana</option>
              <option value="GB">United Kingdom</option>
              <option value="US">United States</option>
              <option value="CA">Canada</option>
            </select>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitbtn" class="w-full btn-3d-emerald text-white font-black py-4 rounded-xl text-sm uppercase tracking-wider mt-4">
          Create Guardian Account 🛡️
        </button>
      </form>

      <!-- Bottom Navigation Footer -->
      <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs font-bold text-slate-500">
        <div>Student Account? <a href="{{{ config.wwwroot }}}/login/signup.php" class="text-blue-600 hover:underline">Student Registration</a></div>
        <div><a href="{{{ config.wwwroot }}}/login/index.php?role=parent" class="text-emerald-600 hover:underline">Guardian Login</a></div>
      </div>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>

<!-- Real-Time Password Validation & Toggle Script -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const toggleButtons = document.querySelectorAll('[data-toggle-password]');
  toggleButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = btn.getAttribute('data-toggle-password');
      const input = document.getElementById(targetId);
      if (input) {
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        btn.classList.toggle('text-emerald-600', isPassword);
        btn.classList.toggle('text-slate-400', !isPassword);
      }
    });
  });

  const pwdInput = document.getElementById('guardian_password');
  const rules = {
    length: document.getElementById('rule-length'),
    upper: document.getElementById('rule-upper'),
    num: document.getElementById('rule-num'),
    spec: document.getElementById('rule-spec')
  };

  if (pwdInput) {
    pwdInput.addEventListener('input', () => {
      const val = pwdInput.value;
      
      const checks = {
        length: val.length >= 8,
        upper: /[A-Z]/.test(val),
        num: /[0-9]/.test(val),
        spec: /[*,-,#,@,!,$,%,&]/.test(val)
      };

      for (const [key, passed] of Object.entries(checks)) {
        const el = rules[key];
        const icon = el.querySelector('.status-icon');
        if (passed) {
          el.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 text-[11px] font-bold border border-emerald-200 transition-colors';
          icon.textContent = '✓';
        } else {
          el.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-400 text-[11px] font-bold border border-slate-200 transition-colors';
          icon.textContent = '○';
        }
      }
    });
  }
});
</script>
</body>
</html>