{{! 
  @template theme_boost/signup
  MindStormer Global Academy (MSA-500) Student Registration Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <style>
    html, body {
      background-color: #F8FAFC !important;
      margin: 0;
      padding: 0;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-tactile {
      background: #FFFFFF;
      border: 2px solid #E2E8F0;
      border-bottom-width: 5px;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04);
    }
    .btn-3d-blue {
      background-color: #2563EB;
      box-shadow: 0 4px 0 #1D4ED8;
      transition: all 0.15s ease;
    }
    .btn-3d-blue:hover {
      background-color: #1D4ED8;
      transform: translateY(-1px);
      box-shadow: 0 6px 12px rgba(37,99,235,0.25), 0 4px 0 #1E40AF;
    }
    .btn-3d-blue:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #1E40AF;
    }
    .msa-student-form label {
      display: block;
      font-size: 0.75rem;
      font-weight: 800;
      color: #334155;
      text-transform: uppercase;
      margin-bottom: 0.375rem;
    }
    .msa-student-form input[type="text"],
    .msa-student-form input[type="email"],
    .msa-student-form input[type="password"],
    .msa-student-form select {
      width: 100%;
      padding: 0.65rem 0.875rem;
      border-radius: 0.75rem;
      border: 2px solid #E2E8F0;
      font-size: 0.875rem;
      font-weight: 600;
      color: #1E293B;
      background-color: #FFFFFF;
      outline: none;
      transition: border-color 0.15s ease;
      margin-bottom: 0.75rem;
    }
    .msa-student-form input:focus,
    .msa-student-form select:focus {
      border-color: #2563EB;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col justify-between">

<div class="msa-page-wrapper flex-1 flex flex-col justify-between">

  <!-- Header -->
  <header class="bg-white border-b-2 border-slate-100 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-[#0F172A] to-blue-900 rounded-xl flex items-center justify-center text-white font-black text-lg border border-blue-500/20">MS</div>
        <span class="font-black text-base text-[#0F172A]">MAYND STORMIR <span class="text-[#2563EB]">ACADEMY</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}/login/index.php" class="text-xs font-bold text-slate-600 hover:text-[#2563EB] transition-colors">Already registered? Log in →</a>
    </div>
  </header>

  <!-- Form Container -->
  <main class="flex-1 flex items-center justify-center p-4 py-12">
    <div class="w-full max-w-lg card-tactile rounded-3xl p-8">
      <div class="text-center mb-8">
        <div class="inline-flex p-3 bg-emerald-50 text-emerald-600 rounded-2xl font-bold text-2xl mb-3 shadow-inner">📝</div>
        <h1 class="text-2xl font-black text-[#0F172A]">Register Student Account</h1>
        <p class="text-xs font-semibold text-slate-500 mt-1">Select your grade level to start your learning track</p>
      </div>

      {{#error}}
      <div class="flex items-center gap-2 p-3 mb-4 text-xs font-bold text-red-700 bg-red-50 border border-red-200 rounded-xl" role="alert">
        <span>⚠️</span> <span>{{error}}</span>
      </div>
      {{/error}}

      <form action="{{{ signupurl }}}" method="post" id="signup" class="space-y-4 msa-student-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="account_type" value="student">

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="firstname">First Name</label>
            <input type="text" id="firstname" name="firstname" required placeholder="Alex">
          </div>
          <div>
            <label for="lastname">Last Name</label>
            <input type="text" id="lastname" name="lastname" required placeholder="O.">
          </div>
        </div>

        <div>
          <label for="email">Student Email Address</label>
          <input type="email" id="email" name="email" required placeholder="alex.o@mindstormer.com">
        </div>

        <div>
          <label for="grade">Grade Level Track</label>
          <select id="grade" name="grade" required>
            <option value="">-- Select Grade (Ages 5–14) --</option>
            <option value="g1">Grade 1 (Foundational)</option>
            <option value="g2">Grade 2 (Elementary)</option>
            <option value="g3">Grade 3 (Elementary)</option>
            <option value="g4">Grade 4 (Intermediate)</option>
            <option value="g5">Grade 5 (Intermediate)</option>
            <option value="g6">Grade 6 (Intermediate)</option>
            <option value="g7" selected>Grade 7 (Junior Secondary)</option>
            <option value="g8">Grade 8 (Junior Secondary)</option>
            <option value="g9">Grade 9 (Junior Secondary)</option>
          </select>
        </div>

        <div class="relative">
          <label for="student_password">Password</label>
          <input type="password" id="student_password" name="password" required placeholder="Minimum 8 characters" class="pr-10">
          <button type="button" data-toggle-password="student_password" class="absolute right-3 top-[34px] text-slate-400 hover:text-slate-600 focus:outline-none p-1 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </button>
        </div>

        <button type="submit" class="w-full btn-3d-blue text-white font-black py-3.5 rounded-xl text-sm uppercase tracking-wider mt-2">
          Create Student Account 🚀
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-slate-100 text-center text-xs font-bold text-slate-500">
        Parent or Guardian? <a href="{{{ config.wwwroot }}}/login/parent_signup.php" class="text-blue-600 hover:underline">Register via Parent Portal</a>
      </div>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const toggleButtons = document.querySelectorAll('[data-toggle-password]');
  toggleButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = btn.getAttribute('data-toggle-password');
      const input = document.getElementById(targetId);
      if (input) {
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        btn.classList.toggle('text-blue-600', isPassword);
        btn.classList.toggle('text-slate-400', !isPassword);
      }
    });
  });
});
</script>
</body>
</html>