{{! 
  @template theme_boost/dashboard
  MindStormer Global Academy (MSA-500) Student Dashboard Template
}}
<div class="msa-corporate-theme bg-[#F8FAFC] text-slate-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- Top Dashboard Header -->
  <header class="bg-[#0F172A] text-white border-b-2 border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[#2563EB] rounded-xl flex items-center justify-center font-black text-white text-lg shadow-md">MS</div>
        <div class="flex flex-col">
          <span class="font-black text-sm tracking-tight text-white">MAYND STORMIR</span>
          <span class="text-[10px] font-extrabold text-[#2563EB] tracking-widest uppercase">ACADEMY ENGINE</span>
        </div>
      </a>

      <!-- Gamified Live Header Indicators -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-xl">
          <span class="text-base">🔥</span>
          <span class="text-xs font-black text-orange-400">7 Days Streak</span>
        </div>
        <div class="flex items-center gap-2 bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-xl">
          <span class="text-base">🏆</span>
          <span class="text-xs font-black text-amber-400">1,850 XP</span>
        </div>
        <a href="{{{ config.wwwroot }}}/login/logout.php?sesskey={{ sesskey }}" class="text-xs font-bold text-slate-400 hover:text-white transition-colors">Sign Out</a>
      </div>
    </div>
  </header>

  <!-- Dashboard Main Grid -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
    
    <!-- Welcome Banner -->
    <div class="bg-gradient-to-r from-[#0F172A] to-blue-900 rounded-2xl p-6 sm:p-8 text-white mb-8 border-2 border-blue-900 shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <span class="bg-blue-500/20 text-blue-300 border border-blue-400/30 font-bold text-[10px] px-2.5 py-1 rounded uppercase tracking-wider">Active Student Track</span>
        <h1 class="text-2xl sm:text-3xl font-black mt-2">Welcome back, {{ fullname }}! 👋</h1>
        <p class="text-xs text-slate-300 font-medium mt-1">Complete your active STEM module to clear your next 80% Mastery Gate.</p>
      </div>
      <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 text-center min-w-[160px]">
        <div class="text-[10px] font-bold text-slate-400 uppercase">Overall CA Standing</div>
        <div class="text-2xl font-black text-emerald-400">88.5%</div>
      </div>
    </div>

    <!-- Moodle Course Overview Block Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-12">
        {{{ output.main_content }}}
      </div>
    </div>

  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>