{{! 
  @template theme_boost/parent_dashboard
  MindStormer Global Academy (MSA-500) Guardian Portal Template
}}
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  body { font-family: 'Plus Jakarta Sans', sans-serif; }
  .card-tactile { background: #FFFFFF; border: 2px solid #E2E8F0; border-bottom-width: 5px; }
  .btn-3d-slate { background-color: #FFFFFF; color: #0F172A; box-shadow: 0 4px 0 #CBD5E1; border: 1px solid #E2E8F0; transition: all 0.2s ease; }
  .btn-3d-slate:hover { background-color: #F8FAFC; border-color: #94A3B8; color: #059669; transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0,0,0,0.05), 0 4px 0 #94A3B8; }
</style>

<div class="bg-[#F8FAFC] text-slate-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- Parent Header -->
  <header class="bg-[#0F172A] text-white border-b-2 border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center font-black text-white text-lg shadow-md">MS</div>
        <div class="flex flex-col">
          <span class="font-black text-sm tracking-tight text-white">MAYND STORMIR</span>
          <span class="text-[10px] font-extrabold text-emerald-400 tracking-widest uppercase">GUARDIAN PORTAL</span>
        </div>
      </a>

      <!-- Child Selector & Logout -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-xl">
          <span class="text-xs font-bold text-slate-400">Linked Student:</span>
          <select data-student-selector class="bg-transparent text-xs font-black text-emerald-400 focus:outline-none cursor-pointer">
            <option value="student_g2" class="bg-slate-900 text-white">Student G2 (Grade 2)</option>
          </select>
        </div>
        <a href="{{{ config.wwwroot }}}/login/logout.php?sesskey={{{ sesskey }}}" class="text-xs font-bold text-slate-400 hover:text-white transition-colors bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">Sign Out</a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
    
    <!-- Standing Overview Card -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border-2 border-slate-200 card-tactile mb-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-100 pb-6 mb-6">
        <div>
          <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-black px-2.5 py-1 rounded uppercase tracking-wider">Active Academic Status</span>
          <h1 data-student-name class="text-2xl sm:text-3xl font-black text-[#0F172A] mt-1">{{ fullname }}</h1>
          <p class="text-xs text-slate-500 font-bold">Grade 2 Module Track • Academic Term 2026/2027</p>
        </div>

        <a href="{{{ config.wwwroot }}}/grade/report/user/index.php" class="btn-3d-slate font-black px-5 py-2.5 rounded-xl text-xs flex items-center gap-2">
          <span>📄</span> Official Grade Transcript
        </a>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-400 uppercase">Term Mastery Average</div>
          <div data-student-avg class="text-2xl font-black text-[#0F172A] mt-0.5">85.0%</div>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-400 uppercase">Mastery Gate (80%)</div>
          <div data-student-streak class="text-2xl font-black text-emerald-600 mt-0.5">Cleared ✓</div>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-400 uppercase">Continuous Assessment</div>
          <div data-student-ca class="text-2xl font-black text-emerald-600 mt-0.5">36.0 / 40</div>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-400 uppercase">Exam / Practical</div>
          <div data-student-exam class="text-2xl font-black text-[#2563EB] mt-0.5">49.0 / 60</div>
        </div>
      </div>
    </div>

    <!-- Moodle Native Parent/Guardian Grade Content -->
    <div class="card-tactile rounded-2xl p-6">
      <h2 class="text-lg font-black text-[#0F172A] mb-4 flex items-center gap-2">
        <span>📋</span> Continuous Assessment & Exam Breakdown
      </h2>
      <div class="overflow-x-auto">
        {{{ output.main_content }}}
      </div>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>
</div>