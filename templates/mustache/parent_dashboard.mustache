{{! 
  @template theme_boost/parent_dashboard
  MindStormer Global Academy (MSA-500) Guardian Portal Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guardian Portal | MindStormer Academy</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    html, body {
      background-color: #F8FAFC !important;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-tactile {
      background: #FFFFFF;
      border: 2px solid #E2E8F0;
      border-bottom-width: 5px;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04);
    }
    .btn-3d-slate {
      background-color: #FFFFFF;
      color: #0F172A;
      box-shadow: 0 4px 0 #CBD5E1;
      border: 1px solid #CBD5E1;
      transition: all 0.15s ease;
    }
    .btn-3d-slate:hover {
      background-color: #F8FAFC;
      border-color: #94A3B8;
      color: #047857;
      transform: translateY(-1px);
      box-shadow: 0 6px 12px rgba(0,0,0,0.05), 0 4px 0 #94A3B8;
    }
    .btn-3d-slate:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #94A3B8;
    }
    a:focus-visible,
    button:focus-visible,
    select:focus-visible {
      outline: 3px solid #059669 !important;
      outline-offset: 2px !important;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col justify-between">

{{{ output.standard_top_of_body_html }}}

<div class="msa-page-wrapper flex-1 flex flex-col justify-between">

  <!-- Guardian Header Landmark -->
  <header role="banner" class="bg-[#0F172A] text-white border-b-2 border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3 focus-visible:rounded-lg" aria-label="MindStormer Global Academy Home">
        <div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center font-black text-white text-lg shadow-md border border-emerald-400/20">MS</div>
        <div class="flex flex-col">
          <span class="font-black text-sm tracking-tight text-white">MAYND STORMIR</span>
          <span class="text-[10px] font-extrabold text-emerald-400 tracking-widest uppercase">GUARDIAN PORTAL</span>
        </div>
      </a>

      <!-- Child Selector & Logout -->
      <div class="flex items-center gap-3 sm:gap-4">
        <div class="flex items-center gap-2 bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-xl">
          <label for="student_selector" class="text-xs font-bold text-slate-300">Linked Student:</label>
          <select id="student_selector" data-student-selector aria-label="Select linked student" class="bg-transparent text-xs font-black text-emerald-400 focus:outline-none cursor-pointer">
            <option value="student_g2" class="bg-slate-900 text-white">Student G2 (Grade 2)</option>
            <option value="student_g7" class="bg-slate-900 text-white">Student G7 (Grade 7)</option>
          </select>
        </div>
        <a href="{{{ config.wwwroot }}}/login/logout.php?sesskey={{{ sesskey }}}" class="text-xs font-bold text-slate-300 hover:text-white transition-colors bg-slate-800 hover:bg-slate-700 px-3.5 py-2 rounded-xl border border-slate-700 focus-visible:ring-2 focus-visible:ring-emerald-400">Sign Out</a>
      </div>
    </div>
  </header>

  <!-- Main Landmark -->
  <main role="main" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
    
    <!-- Standing Overview Card Section -->
    <section aria-labelledby="standing-overview-heading" class="bg-white rounded-3xl p-6 sm:p-8 card-tactile mb-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-100 pb-6 mb-6">
        <div>
          <span class="bg-emerald-50 text-emerald-800 border border-emerald-300 text-[10px] font-black px-2.5 py-1 rounded uppercase tracking-wider">Active Academic Status</span>
          <h1 id="standing-overview-heading" data-student-name class="text-2xl sm:text-3xl font-black text-[#0F172A] mt-1 tracking-tight">{{ fullname }}</h1>
          <p class="text-xs text-slate-600 font-bold mt-0.5">Grade 2 Module Track • Academic Term 2026/2027</p>
        </div>

        <a href="{{{ config.wwwroot }}}/grade/report/user/index.php" class="btn-3d-slate font-black px-5 py-2.5 rounded-xl text-xs flex items-center gap-2 focus-visible:ring-2 focus-visible:ring-emerald-600">
          <span aria-hidden="true">📄</span> Official Grade Transcript
        </a>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" role="region" aria-label="Student Key Metrics">
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Term Mastery Average</div>
          <div data-student-avg class="text-2xl font-black text-[#0F172A] mt-0.5">85.0%</div>
        </div>

        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Mastery Gate (80%)</div>
          <div data-student-streak class="text-2xl font-black text-emerald-700 mt-0.5">Cleared ✓</div>
        </div>

        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Continuous Assessment</div>
          <div data-student-ca class="text-2xl font-black text-emerald-700 mt-0.5">36.0 / 40</div>
        </div>

        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
          <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Exam / Practical</div>
          <div data-student-exam class="text-2xl font-black text-[#2563EB] mt-0.5">49.0 / 60</div>
        </div>
      </div>
    </section>

    <!-- Moodle Grade Content Section -->
    <section aria-labelledby="gradebook-heading" class="card-tactile rounded-3xl p-6">
      <h2 id="gradebook-heading" class="text-lg font-black text-[#0F172A] mb-4 flex items-center gap-2">
        <span aria-hidden="true">📋</span> Continuous Assessment & Exam Breakdown
      </h2>
      <div class="overflow-x-auto" role="region" aria-label="Academic Gradebook Records">
        {{{ output.main_content }}}
      </div>
    </section>
  </main>

  <footer role="contentinfo" class="bg-slate-900 text-slate-400 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>

{{{ output.standard_end_of_body_html }}}
</body>
</html>