{{! 
  @template theme_boost/login
  MindStormer Global Academy (MSA-500) Corporate Login Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <style>
    html, body {
      background-color: #F8FAFC !important;
      margin: 0;
      padding: 0;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-tactile {
      background: #FFFFFF;
      border: 2px solid #E2E8F0;
      border-bottom-width: 5px;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.04);
    }
    
    /* Reset redundant Moodle headings & alerts */
    .msa-login-card h2, 
    .msa-login-card .sr-only {
      display: none !important;
    }

    /* Form Labels & Text Inputs */
    .msa-login-card label {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      color: #475569;
      margin-bottom: 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.025em;
    }
    .msa-login-card input[type="text"],
    .msa-login-card input[type="password"] {
      width: 100%;
      padding: 0.75rem 1rem;
      padding-right: 2.75rem;
      border-radius: 0.75rem;
      border: 1.5px solid #E2E8F0;
      margin: 0.35rem 0 0.75rem 0;
      font-size: 0.875rem;
      outline: none;
      background-color: #FFFFFF;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .msa-login-card input[type="text"]:focus,
    .msa-login-card input[type="password"]:focus {
      border-color: #2563EB;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    /* Primary Action Button (Log in) */
    .msa-login-card input[type="submit"]#loginbtn,
    .msa-login-card button#loginbtn,
    .msa-login-card .btn-primary {
      width: 100%;
      background-color: #2563EB !important;
      color: #FFFFFF !important;
      font-weight: 800 !important;
      font-size: 0.875rem !important;
      padding: 0.875rem 1rem !important;
      border-radius: 0.75rem !important;
      border: none !important;
      cursor: pointer;
      box-shadow: 0 4px 0 #1D4ED8 !important;
      margin-top: 0.5rem;
      margin-bottom: 0.75rem;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }
    .msa-login-card input[type="submit"]#loginbtn:hover,
    .msa-login-card button#loginbtn:hover,
    .msa-login-card .btn-primary:hover {
      background-color: #1D4ED8 !important;
      transform: translateY(-1px);
      box-shadow: 0 5px 10px rgba(37,99,235,0.25), 0 3px 0 #1E40AF !important;
    }
    .msa-login-card input[type="submit"]#loginbtn:active,
    .msa-login-card button#loginbtn:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #1E40AF !important;
    }

    /* Moodle Native Error Alert Box */
    .msa-login-card .alert-danger,
    .msa-login-card .loginerrors {
      background-color: #FEF2F2 !important;
      border: 1.5px solid #FECACA !important;
      color: #B91C1C !important;
      font-size: 0.8125rem !important;
      font-weight: 600 !important;
      border-radius: 0.75rem !important;
      padding: 0.75rem 1rem !important;
      margin-bottom: 1rem !important;
      display: flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col justify-between">

<div class="msa-page-wrapper flex-1 flex flex-col justify-between">

  <!-- Header Navigation -->
  <header class="bg-white border-b-2 border-slate-100 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-[#0F172A] to-blue-900 rounded-xl flex items-center justify-center text-white font-black text-lg border border-blue-500/20">MS</div>
        <span class="font-black text-base text-[#0F172A]">MAYND STORMIR <span class="text-[#2563EB]">ACADEMY</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}/login/parent_login.php" class="text-xs font-bold text-slate-600 hover:text-[#2563EB] transition-colors">Parent Portal →</a>
    </div>
  </header>

  <!-- Login Form Container -->
  <main class="flex-1 flex items-center justify-center p-4 py-8">
    <div class="msa-login-card card-tactile w-full max-w-md bg-white rounded-3xl p-8">
      <div class="text-center mb-6">
        <div class="inline-flex p-3 bg-blue-50 text-[#2563EB] rounded-2xl font-bold text-3xl mb-3 shadow-inner">🎓</div>
        <h1 class="text-2xl font-black text-[#0F172A] tracking-tight">Student Portal Login</h1>
        <p class="text-xs font-semibold text-slate-400 mt-1">Enter your student credentials to access your modules</p>
      </div>

      <!-- Native Moodle Output Buffer -->
      <div class="moodle-login-form-container">
        {{{ output.main_content }}}
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 text-center">
        <p class="text-xs font-semibold text-slate-500">
          Need an account? <a href="{{{ config.wwwroot }}}/login/signup.php" class="text-[#2563EB] font-bold hover:underline">Register Student Account</a>
        </p>
      </div>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>

<!-- Password Show/Hide Toggle Script -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const pwdInput = document.querySelector('input[type="password"]');
  if (pwdInput && !pwdInput.dataset.toggleAttached) {
    pwdInput.dataset.toggleAttached = 'true';
    const parent = pwdInput.parentElement;
    parent.classList.add('relative');

    const toggleBtn = document.createElement('button');
    toggleBtn.type = 'button';
    toggleBtn.className = 'absolute right-3 top-[18px] text-slate-400 hover:text-slate-600 focus:outline-none p-1 transition-colors';
    toggleBtn.innerHTML = `
      <svg class="w-5 h-5 eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
    `;

    pwdInput.insertAdjacentElement('afterend', toggleBtn);

    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isPassword = pwdInput.type === 'password';
      pwdInput.type = isPassword ? 'text' : 'password';
      toggleBtn.classList.toggle('text-blue-600', isPassword);
      toggleBtn.classList.toggle('text-slate-400', !isPassword);
    });
  }
});
</script>
</body>
</html>