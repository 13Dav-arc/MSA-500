{{! 
  @template theme_boost/login
  MindStormer Global Academy (MSA-500) Corporate Login Template
}}
<div class="msa-corporate-theme bg-[#F8FAFC] text-slate-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- Header Navigation -->
  <header class="bg-white border-b-2 border-slate-100 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-[#0F172A] to-blue-900 rounded-xl flex items-center justify-center text-white font-black text-lg border border-blue-500/20">MS</div>
        <span class="font-black text-base text-[#0F172A]">MAYND STORMIR <span class="text-[#2563EB]">ACADEMY</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}/login/index.php" class="text-xs font-bold text-slate-600 hover:text-[#2563EB] transition-colors">Parent Portal →</a>
    </div>
  </header>

  <!-- Login Form Container -->
  <main class="flex-1 flex items-center justify-center p-4 py-12">
    <div class="w-full max-w-md bg-white border-2 border-slate-200 border-b-[5px] rounded-2xl p-8 shadow-xl">
      <div class="text-center mb-8">
        <div class="inline-flex p-3 bg-blue-50 text-[#2563EB] rounded-xl font-bold text-2xl mb-3">🎓</div>
        <h1 class="text-2xl font-black text-[#0F172A]">Student Portal Login</h1>
        <p class="text-xs font-semibold text-slate-500 mt-1">Enter your student credentials to access your modules</p>
      </div>

      <!-- Native Moodle Main Output Buffer (Form & Notifications) -->
      <div class="moodle-login-form-container">
        {{{ output.main_content }}}
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100 text-center text-xs font-bold text-slate-500">
        Need an account? <a href="{{{ config.wwwroot }}}/login/signup.php" class="text-[#2563EB] hover:underline">Register Student Account</a>
      </div>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>