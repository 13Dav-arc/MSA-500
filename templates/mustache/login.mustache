{{! 
  @template theme_boost/login
  MindStormer Global Academy (MSA-500) Corporate Login Template
}}
<!-- Tailwind CSS & Google Fonts -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #F8FAFC;
  }
  
  /* Reset redundant Moodle headings */
  .msa-login-card h2, 
  .msa-login-card .sr-only {
    display: none !important;
  }

  /* Form Labels & Text Inputs */
  .msa-login-card label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.25rem;
  }
  .msa-login-card input[type="text"],
  .msa-login-card input[type="password"] {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1.5px solid #E2E8F0;
    margin-top: 0.25rem;
    margin-bottom: 0.875rem;
    font-size: 0.875rem;
    outline: none;
    transition: all 0.2s ease;
  }
  .msa-login-card input[type="text"]:focus,
  .msa-login-card input[type="password"]:focus {
    border-color: #2563EB;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  /* Primary Action Button (Log in) */
  .msa-login-card input[type="submit"]#loginbtn,
  .msa-login-card button#loginbtn,
  .msa-login-card .btn-primary {
    width: 100%;
    background-color: #2563EB !important;
    color: #FFFFFF !important;
    font-weight: 700 !important;
    font-size: 0.875rem !important;
    padding: 0.75rem 1rem !important;
    border-radius: 0.75rem !important;
    border: none !important;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .msa-login-card input[type="submit"]#loginbtn:hover,
  .msa-login-card button#loginbtn:hover,
  .msa-login-card .btn-primary:hover {
    background-color: #1D4ED8 !important;
    transform: translateY(-1px);
  }

  /* Secondary Buttons (Guest / Cookies) */
  .msa-login-card .btn-secondary,
  .msa-login-card form:not(#login) input[type="submit"],
  .msa-login-card form:not(#login) button {
    width: 100%;
    background-color: #F8FAFC !important;
    color: #475569 !important;
    font-weight: 600 !important;
    font-size: 0.8125rem !important;
    padding: 0.625rem 1rem !important;
    border-radius: 0.625rem !important;
    border: 1.5px solid #E2E8F0 !important;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .msa-login-card .btn-secondary:hover,
  .msa-login-card form:not(#login) input[type="submit"]:hover,
  .msa-login-card form:not(#login) button:hover {
    background-color: #EDF2F7 !important;
    color: #0F172A !important;
  }

  /* Links & Dividers */
  .msa-login-card a {
    color: #2563EB;
    font-weight: 600;
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .msa-login-card a:hover {
    color: #1D4ED8;
    text-decoration: underline;
  }
  .msa-login-card .d-flex, 
  .msa-login-card .forgetpass {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    text-align: center;
  }
</style>

<div class="msa-corporate-theme bg-[#F8FAFC] text-slate-800 antialiased min-h-screen flex flex-col justify-between">

  <!-- Header Navigation -->
  <header class="bg-white border-b-2 border-slate-100 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-[#0F172A] to-blue-900 rounded-xl flex items-center justify-center text-white font-black text-lg border border-blue-500/20">MS</div>
        <span class="font-black text-base text-[#0F172A]">MAYND STORMIR <span class="text-[#2563EB]">ACADEMY</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}" class="text-xs font-bold text-slate-600 hover:text-[#2563EB] transition-colors">← Back to Portal</a>
    </div>
  </header>

  <!-- Login Form Container -->
  <main class="flex-1 flex items-center justify-center p-4 py-8">
    <div class="msa-login-card w-full max-w-md bg-white border-2 border-slate-200 border-b-[5px] rounded-3xl p-8 shadow-xl">
      <div class="text-center mb-6">
        <div class="inline-flex p-3 bg-blue-50 text-[#2563EB] rounded-2xl font-bold text-3xl mb-3 shadow-inner">🎓</div>
        <h1 class="text-2xl font-black text-[#0F172A] tracking-tight">Student Portal Login</h1>
        <p class="text-xs font-semibold text-slate-400 mt-1">Enter your student credentials to access your modules</p>
      </div>

      <!-- Native Moodle Main Output Buffer (Form & Notifications) -->
      <div class="moodle-login-form-container">
        {{{ output.main_content }}}
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 text-center">
        <p class="text-xs font-semibold text-slate-500">
          Need an account? <a href="{{{ config.wwwroot }}}/login/signup.php" class="text-[#2563EB] font-bold hover:underline">Register Student Account</a>
        </p>
      </div>
    </div>
  </main>

  <footer class="bg-slate-900 text-slate-500 text-center text-xs py-4">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>