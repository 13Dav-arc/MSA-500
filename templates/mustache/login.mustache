{{! 
  @template theme_boost/login
  MindStormer Global Academy (MSA-500) Corporate Login Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Login | MindStormer Academy</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    html, body {
      background-color: #F8FAFC !important;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-tactile {
      background: #FFFFFF;
      border: 2px solid #E2E8F0;
      border-bottom-width: 6px;
      box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
    }
    .btn-3d-blue {
      background-color: #2563EB;
      box-shadow: 0 4px 0 #1D4ED8;
      transition: all 0.15s ease;
    }
    .btn-3d-blue:hover {
      background-color: #1D4ED8;
      transform: translateY(-1px);
      box-shadow: 0 6px 14px rgba(37,99,235,0.25), 0 4px 0 #1E40AF;
    }
    .btn-3d-blue:active {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #1E40AF;
    }
    .btn-3d-blue:focus-visible,
    .msa-form input:focus-visible,
    a:focus-visible,
    button:focus-visible {
      outline: 3px solid #2563EB !important;
      outline-offset: 2px !important;
    }
    .msa-form label {
      display: block;
      font-size: 0.75rem;
      font-weight: 800;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.375rem;
    }
    .msa-form input[type="text"],
    .msa-form input[type="password"] {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 0.875rem;
      border: 2px solid #CBD5E1;
      font-size: 0.875rem;
      font-weight: 600;
      color: #0F172A;
      background-color: #FFFFFF;
      outline: none;
      transition: all 0.2s ease;
    }
    .msa-form input:focus {
      border-color: #2563EB;
      box-shadow: 0 0 0 3.5px rgba(37, 99, 235, 0.15);
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col justify-between">

{{{ output.standard_top_of_body_html }}}

<div class="msa-page-wrapper flex-1 flex flex-col justify-between">

  <!-- Header Navigation Landmark -->
  <header role="banner" class="bg-white border-b-2 border-slate-100 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3 focus-visible:rounded-lg" aria-label="MindStormer Global Academy Home">
        <div class="w-10 h-10 bg-gradient-to-br from-[#0F172A] to-blue-900 rounded-xl flex items-center justify-center text-white font-black text-lg border border-blue-500/20 shadow-sm">MS</div>
        <span class="font-black text-base text-[#0F172A]">MAYND STORMIR <span class="text-[#2563EB]">ACADEMY</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}/login/index.php?role=parent" class="text-xs font-bold text-slate-700 hover:text-[#2563EB] transition-colors focus-visible:rounded px-2 py-1">Guardian Portal →</a>
    </div>
  </header>

  <!-- Login Form Card -->
  <main role="main" class="flex-1 flex items-center justify-center p-4 py-8">
    <div class="msa-login-card card-tactile w-full max-w-md bg-white rounded-3xl p-8">
      <div class="text-center mb-6">
        <div class="inline-flex p-3 bg-blue-50 text-[#2563EB] rounded-2xl font-bold text-3xl mb-3 shadow-inner" aria-hidden="true">🎓</div>
        <h1 class="text-2xl sm:text-3xl font-black text-[#0F172A] tracking-tight">Student Portal Login</h1>
        <p class="text-xs font-medium text-slate-600 mt-1">Enter your student credentials to access your modules</p>
      </div>

      {{#error}}
      <div class="flex items-center gap-2 p-3.5 mb-4 text-xs font-bold text-red-800 bg-red-50 border-2 border-red-300 rounded-xl" role="alert" aria-live="assertive">
        <span aria-hidden="true">⚠️</span> <span>{{error}}</span>
      </div>
      {{/error}}

      <!-- Direct Form Execution -->
      <form action="{{{ loginurl }}}" method="post" id="login" class="space-y-4 msa-form" novalidate>
        <input type="hidden" name="logintoken" value="{{logintoken}}">

        <div>
          <label for="username">Student Username or Email</label>
          <input type="text" id="username" name="username" value="{{username}}" placeholder="e.g. student_g2" autocomplete="username" required aria-required="true" {{#error}}aria-invalid="true"{{/error}}>
        </div>

        <div class="relative">
          <label for="password">Password</label>
          <div class="relative">
            <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required aria-required="true" class="pr-11" {{#error}}aria-invalid="true"{{/error}}>
            <button type="button" data-toggle-password="password" aria-label="Show password" aria-pressed="false" class="absolute right-3 top-[10px] text-slate-500 hover:text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg p-1.5 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" id="loginbtn" class="w-full btn-3d-blue text-white font-black py-4 rounded-xl text-sm uppercase tracking-wider mt-2 cursor-pointer">
          Log In to Student Portal 🚀
        </button>
      </form>

      <!-- Accessible Footer Links -->
      <div class="mt-6 pt-4 border-t border-slate-100 flex justify-between items-center text-xs font-bold text-slate-600">
        <div><a href="{{{ forgotpasswordurl }}}" class="text-slate-600 hover:text-[#2563EB] hover:underline focus-visible:rounded px-1">Forgot password?</a></div>
        <div><a href="{{{ config.wwwroot }}}/login/signup.php" class="text-[#2563EB] hover:text-[#1D4ED8] hover:underline focus-visible:rounded px-1">Register Student Account</a></div>
      </div>
    </div>
  </main>

  <footer role="contentinfo" class="bg-slate-900 text-slate-400 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>
</div>

<script src="assets/js/form-validation.js" defer></script>

{{{ output.standard_end_of_body_html }}}
</body>
</html>