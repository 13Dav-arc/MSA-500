{{!
  @template theme_boost/gamification_bar
  MindStormer Global Academy (MSA-500) Student Gamification & Progress Bar Partial
  Tactile Blue System, WCAG 2.1 AA Compliant
}}
<section role="region" aria-label="Student Gamification and Daily Progress" class="card-tactile bg-white rounded-3xl p-5 sm:p-6 mb-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">

    <!-- Streak Module (Col 1: 4 cols) -->
    <div class="lg:col-span-4 bg-slate-50 border border-slate-200 rounded-2xl p-4 flex flex-col justify-between h-full">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-xl bg-orange-100 border border-orange-300 text-orange-600 flex items-center justify-center text-lg font-bold shadow-sm" aria-hidden="true">🔥</span>
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Active Streak</span>
            <div class="text-base font-black text-[#0F172A] leading-tight" role="status" aria-label="Current streak: {{#streak_count}}{{streak_count}}{{/streak_count}}{{^streak_count}}7{{/streak_count}} days active">
              {{#streak_count}}{{streak_count}}{{/streak_count}}{{^streak_count}}7{{/streak_count}} Days Active
            </div>
          </div>
        </div>
        <span class="bg-orange-50 text-orange-700 border border-orange-200 text-[10px] font-extrabold px-2 py-0.5 rounded-lg">On Fire!</span>
      </div>

      <!-- Weekly 7-Day Tactile Schedule Track -->
      <div class="grid grid-cols-7 gap-1.5 pt-2 border-t border-slate-200" role="group" aria-label="Weekly Active Days">
        <div class="flex flex-col items-center gap-1">
          <span class="text-[9px] font-extrabold text-slate-400 uppercase">M</span>
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm" title="Monday: Completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Monday: Completed</span>
          </div>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="text-[9px] font-extrabold text-slate-400 uppercase">T</span>
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm" title="Tuesday: Completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Tuesday: Completed</span>
          </div>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="text-[9px] font-extrabold text-slate-400 uppercase">W</span>
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm" title="Wednesday: Completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Wednesday: Completed</span>
          </div>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="text-[9px] font-extrabold text-slate-400 uppercase">T</span>
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm" title="Thursday: Completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Thursday: Completed</span>
          </div>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="text-[9px] font-extrabold text-slate-400 uppercase">F</span>
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm" title="Friday: Completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Friday: Completed</span>
          </div>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="text-[9px] font-extrabold text-slate-400 uppercase">S</span>
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-emerald-500 text-white font-black text-xs flex items-center justify-center shadow-sm" title="Saturday: Completed">
            <span aria-hidden="true">✓</span>
            <span class="sr-only">Saturday: Completed</span>
          </div>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="text-[9px] font-extrabold text-blue-600 uppercase font-black">S</span>
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-sm ring-2 ring-blue-300 animate-pulse" title="Sunday: Active Today">
            <span aria-hidden="true">★</span>
            <span class="sr-only">Sunday: Active Today</span>
          </div>
        </div>
      </div>
    </div>

    <!-- XP & Level Milestone Module (Col 2: 4 cols) -->
    <div class="lg:col-span-4 bg-slate-50 border border-slate-200 rounded-2xl p-4 flex flex-col justify-between h-full">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-xl bg-amber-100 border border-amber-300 text-amber-700 flex items-center justify-center text-lg font-bold shadow-sm" aria-hidden="true">🏆</span>
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">{{#current_level}}{{current_level}}{{/current_level}}{{^current_level}}Level 4 Explorer{{/current_level}}</span>
            <div class="text-base font-black text-[#0F172A] leading-tight" role="status" aria-label="Experience points: {{#current_xp}}{{current_xp}}{{/current_xp}}{{^current_xp}}1,850{{/current_xp}} XP">
              {{#current_xp}}{{current_xp}}{{/current_xp}}{{^current_xp}}1,850{{/current_xp}} <span class="text-xs font-bold text-amber-600">XP</span>
            </div>
          </div>
        </div>
        <span class="bg-amber-50 text-amber-800 border border-amber-300 text-[10px] font-extrabold px-2 py-0.5 rounded-lg">Level 4</span>
      </div>

      <!-- XP Milestone Progress Bar -->
      <div>
        <div class="flex justify-between text-[10px] font-bold text-slate-500 mb-1.5">
          <span>Level 5 Milestone</span>
          <span class="text-blue-600 font-extrabold">150 XP remaining</span>
        </div>
        <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden p-0.5 border border-slate-300" role="progressbar" aria-valuenow="92" aria-valuemin="0" aria-valuemax="100" aria-valuetext="92% of Level 4 completed">
          <div class="bg-gradient-to-r from-amber-500 to-blue-600 h-full rounded-full transition-all duration-700" style="width: 92%;"></div>
        </div>
        <div class="flex justify-between text-[9px] font-bold text-slate-400 mt-1">
          <span>1,000 XP</span>
          <span>Target: 2,000 XP</span>
        </div>
      </div>
    </div>

    <!-- 80% Mastery Gate Progress Trajectory (Col 3: 4 cols) -->
    <div class="lg:col-span-4 bg-slate-50 border border-slate-200 rounded-2xl p-4 flex flex-col justify-between h-full">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-xl bg-emerald-100 border border-emerald-300 text-emerald-700 flex items-center justify-center text-lg font-bold shadow-sm" aria-hidden="true">⚡</span>
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Term CA Trajectory</span>
            <div class="text-base font-black text-emerald-600 leading-tight">
              {{#ca_standing}}{{ca_standing}}{{/ca_standing}}{{^ca_standing}}88.5%{{/ca_standing}} <span class="text-xs font-bold text-slate-500">(40% Weight)</span>
            </div>
          </div>
        </div>
        <span class="bg-emerald-50 text-emerald-800 border border-emerald-300 text-[10px] font-extrabold px-2 py-0.5 rounded-lg">Gate Cleared ✓</span>
      </div>

      <!-- 80% Gate Standard Progress Meter -->
      <div>
        <div class="flex justify-between text-[10px] font-bold text-slate-500 mb-1.5">
          <span>Mastery Standard (80%)</span>
          <span class="text-emerald-700 font-extrabold">Passed Standard</span>
        </div>
        <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden p-0.5 border border-slate-300 relative" role="progressbar" aria-valuenow="88.5" aria-valuemin="0" aria-valuemax="100" aria-valuetext="Continuous Assessment standing at 88.5%, exceeding 80% Mastery Gate">
          <div class="absolute left-[80%] top-0 bottom-0 w-0.5 bg-amber-500 z-10" title="80% Mastery Gate Indicator"></div>
          <div class="bg-emerald-500 h-full rounded-full transition-all duration-700" style="width: 88.5%;"></div>
        </div>
        <div class="flex justify-between text-[9px] font-bold text-slate-400 mt-1">
          <span>0%</span>
          <span class="text-amber-600 font-extrabold">80% Gate</span>
          <span>100%</span>
        </div>
      </div>
    </div>

  </div>
</section>
