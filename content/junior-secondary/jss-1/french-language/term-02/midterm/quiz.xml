      <text><![CDATA[<p>Your answer is incorrect.</p>]]></text>
    </incorrectfeedback>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>Because amie is masculine</p>]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. *Mon* replaces *ma* before feminine nouns starting with a vowel to ensure euphony.</p>]]></text>
      </feedback>
    </answer>
