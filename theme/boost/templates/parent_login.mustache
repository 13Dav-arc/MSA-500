{{! 
  @template theme_boost/parent_login
  MindStormer Global Academy (MSA-500) Enterprise Guardian Portal Login
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guardian Login | MindStormer Academy</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    html, body {
      background-color: #F8FAFC !important;
      min-height: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      font-family: 'Inter', sans-serif;
    }
    h1, h2, h3, .font-heading {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    /* Suppress Moodle core auto-injected buttons & wrappers */
    .d-password-unmask,
    .form-password-unmask,
    .input-group-append,
    .input-group-text,
    [data-action="toggle-password"],
    [data-action="show-password"],
    [data-action="hide-password"],
    button[data-toggle="password"],
    .btn[data-action="show-password"] {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      position: absolute !important;
      width: 0 !important;
      height: 0 !important;
      opacity: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
    }
    /* Explicit Custom Password Toggle Button & SVG Sizing */
    button[data-pw-toggle] {
      display: inline-flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      position: absolute !important;
      right: 0.75rem !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      z-index: 20 !important;
      background: transparent !important;
      border: none !important;
      padding: 0.375rem !important;
      cursor: pointer !important;
      color: #64748B !important;
    }
    button[data-pw-toggle]:hover {
      color: #0F172A !important;
    }
    button[data-pw-toggle] svg {
      width: 20px !important;
      height: 20px !important;
      min-width: 20px !important;
      min-height: 20px !important;
      stroke: currentColor !important;
    }
    button[data-pw-toggle] svg.pw-eye-open {
      display: block !important;
    }
    button[data-pw-toggle] svg.pw-eye-slash {
      display: none !important;
    }
    button[data-pw-toggle] svg.hidden {
      display: none !important;
    }
    button[data-pw-toggle] svg.block {
      display: block !important;
    }
    /* Disable native browser password reveal & autofill icons across all browsers */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear,
    input[type="password"]::-webkit-contacts-auto-fill-button,
    input[type="password"]::-webkit-credentials-auto-fill-button {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      position: absolute !important;
      right: 0 !important;
      width: 0 !important;
      height: 0 !important;
    }
    .card-enterprise {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
    }
    .btn-enterprise-emerald {
      background-color: #047857;
      color: #FFFFFF;
      border-radius: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
    }
    .btn-enterprise-emerald:hover {
      background-color: #065F46;
      box-shadow: 0 4px 6px -1px rgba(4, 120, 87, 0.2);
    }
    .btn-enterprise-emerald:focus-visible,
    .msa-parent-form input:focus-visible,
    a:focus-visible,
    button:focus-visible {
      outline: 3px solid #047857 !important;
      outline-offset: 2px !important;
    }
    .msa-parent-form label {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.375rem;
    }
    .msa-parent-form input[type="text"],
    .msa-parent-form input[type="password"] {
      width: 100%;
      min-height: 48px;
      padding: 0.75rem 1rem;
      border-radius: 0.75rem;
      border: 1px solid #CBD5E1;
      font-size: 1rem;
      font-weight: 500;
      color: #0F172A;
      background-color: #FFFFFF;
      outline: none;
      transition: all 0.2s ease;
    }
    @media (min-width: 640px) {
      .msa-parent-form input[type="text"],
      .msa-parent-form input[type="password"] {
        font-size: 0.875rem;
      }
    }
    .msa-parent-form input:focus {
      border-color: #047857;
      box-shadow: 0 0 0 3px rgba(4, 120, 87, 0.15);
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
    #topofscroll,
    #toast-wrapper:empty {
      display: none !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  </style>

  {{{ output.standard_head_html }}}
</head>
<body class="text-slate-800 antialiased min-h-[100dvh] overflow-x-hidden">

{{{ output.standard_top_of_body_html }}}

<!-- WCAG 2.1 AA Skip to Main Content Bypass Link -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-[#047857] focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold focus:shadow-lg focus:outline-none">Skip to main content</a>

<div class="msa-page-wrapper min-h-[100dvh] flex flex-col justify-between w-full overflow-x-hidden">

  <!-- Guardian Header Landmark -->
  <header role="banner" class="w-full bg-white border-b border-slate-200 py-3.5 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}/index.html" class="flex items-center gap-3 focus:outline-none focus-visible:rounded-lg min-h-[48px]" aria-label="MindStormer Global Academy Home">
        <div class="w-10 h-10 bg-[#0F172A] rounded-xl flex items-center justify-center text-white font-black text-base border border-slate-700 shadow-sm flex-shrink-0">MS</div>
        <div class="flex flex-col">
          <span class="text-sm sm:text-base font-black tracking-tight text-slate-900 leading-none whitespace-nowrap font-heading">MAYND STORMIR</span>
          <span class="text-[10px] font-bold text-emerald-700 tracking-wider leading-tight uppercase">GUARDIAN PORTAL</span>
        </div>
      </a>
      <a href="{{{ config.wwwroot }}}/login/index.php" class="text-xs font-bold text-slate-700 hover:text-[#1D4ED8] transition-colors focus-visible:rounded px-2 py-1 min-h-[48px] inline-flex items-center">Student Login →</a>
    </div>
  </header>

  <!-- Login Main Container Landmark -->
  <main id="main-content" role="main" class="flex-1 flex items-center justify-center p-4 sm:p-6 md:p-8 w-full">
    <div class="msa-parent-card card-enterprise w-full max-w-md bg-white rounded-2xl p-4 sm:p-6 md:p-8 lg:p-10">
      <div class="text-center mb-6">
        <div class="inline-flex p-3 bg-emerald-50 text-[#047857] rounded-xl font-bold mb-3 shadow-sm" aria-hidden="true">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h1 class="text-2xl font-black text-[#0F172A] tracking-tight font-heading">Guardian Portal Login</h1>
        <p class="text-xs font-medium text-slate-600 mt-1">Sign in to review verified academic performance and continuous assessment metrics</p>
      </div>

      {{#error}}
      <div class="flex items-center gap-2 p-3.5 mb-4 text-xs font-bold text-red-800 bg-red-50 border border-red-300 rounded-lg" role="alert" aria-live="assertive">
        <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{{error}}</span>
      </div>
      {{/error}}

      <form action="{{{ loginurl }}}" method="post" id="login" name="login" class="space-y-4 msa-parent-form" novalidate>
        <input type="hidden" name="logintoken" value="{{logintoken}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="wantsurl" value="{{{ config.wwwroot }}}/grade/report/user/index.php">

        <div>
          <label for="username">Guardian Username or Email</label>
          <input type="text" id="username" name="username" value="{{username}}" placeholder="e.g. parent_g2" autocomplete="username email" required aria-required="true" {{#error}}aria-invalid="true"{{/error}}>
        </div>

        <div class="relative">
          <label for="password">Password</label>
          <div class="relative w-full flex items-center">
            <input 
              type="password" 
              id="password" 
              name="password" 
              placeholder="••••••••" 
              autocomplete="current-password" 
              required 
              aria-required="true" 
              class="w-full pr-12 py-2.5 sm:py-3.5 px-4 rounded-xl border border-slate-300 text-base sm:text-sm text-slate-900 focus:outline-none focus:border-emerald-600 transition-colors" 
              {{#error}}aria-invalid="true"{{/error}}
            >
            <button 
              type="button" 
              data-pw-toggle="password" 
              aria-label="Toggle password visibility" 
              aria-pressed="false" 
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 bg-transparent border-0 p-1.5 inline-flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded-lg cursor-pointer z-10"
            >
              <!-- Eye Open Icon (Visible by default) -->
              <svg class="pw-eye-open w-5 h-5 block" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <!-- Eye Slash Icon (Hidden by default) -->
              <svg class="pw-eye-slash w-5 h-5 hidden" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" id="loginbtn" class="w-full btn-enterprise-emerald text-white font-bold py-2.5 sm:py-3.5 px-4 min-h-[44px] sm:min-h-[48px] text-xs sm:text-sm uppercase tracking-wider rounded-xl transition-all cursor-pointer">
          Access Guardian Portal
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-slate-100 flex justify-between items-center text-xs font-semibold text-slate-600">
        <div><a href="{{{ forgotpasswordurl }}}" class="text-slate-600 hover:text-slate-900 hover:underline focus-visible:rounded px-1">Forgot password?</a></div>
        <div><a href="{{{ config.wwwroot }}}/login/signup.php?role=parent" class="text-[#047857] hover:text-[#065F46] hover:underline focus-visible:rounded px-1">Register Guardian Account</a></div>
      </div>
    </div>
  </main>

  <footer role="contentinfo" class="w-full bg-[#0F172A] text-slate-400 text-center text-xs py-4 border-t border-slate-800 mt-auto">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>
</div>

<script src="{{{ config.wwwroot }}}/theme/boost/javascript/form-validation.js" defer></script>
</body>
</html>
