{{! 
  @template theme_boost/dashboard
  MindStormer Global Academy (MSA-500) Enterprise Student Dashboard Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard | MindStormer Academy</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    html, body {
      background-color: #F8FAFC !important;
      min-height: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      font-family: 'Inter', sans-serif;
    }
    h1, h2, h3, h4, .font-heading {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-enterprise {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 1rem;
      box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.05);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-enterprise:hover {
      border-color: #CBD5E1;
      box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.07);
    }
    .btn-enterprise-primary,
    a.btn-enterprise-primary,
    .msa-btn-resume {
      background-color: #1D4ED8 !important;
      color: #FFFFFF !important;
      text-decoration: none !important;
      border: 1px solid transparent;
      border-radius: 0.625rem;
      font-weight: 700;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      min-height: 44px;
      cursor: pointer;
      box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.08);
      transition: all 0.15s ease;
    }
    .btn-enterprise-primary:hover,
    .btn-enterprise-primary:focus,
    a.btn-enterprise-primary:hover,
    a.btn-enterprise-primary:focus,
    .msa-btn-resume:hover,
    .msa-btn-resume:focus {
      background-color: #1E40AF !important;
      color: #FFFFFF !important;
      text-decoration: none !important;
      box-shadow: 0 4px 6px -1px rgba(29, 78, 216, 0.2);
    }
    .btn-enterprise-outline {
      background-color: #FFFFFF;
      color: #0F172A;
      border: 1px solid #CBD5E1;
      border-radius: 0.625rem;
      font-weight: 700;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      min-height: 44px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-enterprise-outline:hover {
      background-color: #F8FAFC;
      border-color: #94A3B8;
      color: #1D4ED8;
    }
    a:focus-visible,
    button:focus-visible,
    select:focus-visible {
      outline: 3px solid #1D4ED8 !important;
      outline-offset: 2px !important;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
    /* Zero-Gap Top Layout Reset */
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      background-color: #F8FAFC !important;
    }
    #page,
    #page.drawers {
      margin-top: 0 !important;
      padding-top: 0 !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    .skiplinks {
      position: absolute !important;
      top: -9999px !important;
      left: -9999px !important;
      height: 1px !important;
      width: 1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
    }
    .skiplinks a:focus,
    .skiplinks a:focus-visible {
      position: fixed !important;
      top: 0.75rem !important;
      left: 0.75rem !important;
      z-index: 9999 !important;
      background-color: #1D4ED8 !important;
      color: #FFFFFF !important;
      padding: 0.625rem 1.25rem !important;
      border-radius: 0.5rem !important;
      font-weight: 700 !important;
      font-size: 0.875rem !important;
      outline: 3px solid #1D4ED8 !important;
      outline-offset: 2px !important;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2) !important;
    }
    a.msa-brand-link,
    a.msa-brand-link:hover,
    a.msa-brand-link:focus,
    a.msa-brand-link:active,
    a.msa-brand-link * {
      text-decoration: none !important;
    }
  </style>

  {{{ output.standard_head_html }}}
</head>
<body class="text-slate-800 antialiased min-h-[100dvh] overflow-x-hidden flex flex-col justify-between">

