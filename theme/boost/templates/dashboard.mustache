        </div>
      </div>

      <!-- Zero-Shift 16:9 Aspect Ratio Iframe Containment with Facade & Fallback -->
      <div class="lab-iframe-wrapper relative">
        
        <!-- Interactive Click-to-Load Facade (Zero Initial WebGL Load & Zero Mobile Scroll Trapping) -->
        <div class="lab-facade-cover" id="lab-facade">
          <div class="w-14 h-14 rounded-xl bg-blue-600/20 border border-blue-400/40 text-blue-400 flex items-center justify-center mb-3 shadow-inner" aria-hidden="true">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-base font-black text-white mb-1 font-heading">Interactive DC Circuit Builder</h3>
          <p class="text-xs text-slate-300 max-w-md mb-5 font-medium leading-relaxed">
            Construct working DC electrical loops, measure live current flow, test resistor resistance, and evaluate Ohm's Law in real-time.
          </p>
          <button type="button" id="btn-launch-sim" onclick="const c = document.getElementById('lab-facade'); const ifr = document.getElementById('phet-iframe'); c.classList.add('lab-loaded'); if(!ifr.src){ifr.src=ifr.dataset.src;}" class="btn-enterprise-primary text-white font-bold px-6 py-2.5 rounded-lg text-xs flex items-center gap-2 min-h-[44px]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Launch Virtual Laboratory
          </button>
        </div>

        <!-- Dynamic Iframe Mount -->
        <iframe 
          id="phet-iframe"
          data-src="https://phet.colorado.edu/sims/html/circuit-construction-kit-dc/latest/circuit-construction-kit-dc_all.html" 
          title="PhET Circuit Construction Kit: DC Interactive Simulation" 
          allow="fullscreen; autoplay; encrypted-media"
          loading="lazy">
        </iframe>

        <!-- Graceful Offline / Unreachable Notice Card -->
        <div class="lab-fallback-card" id="lab-fallback">
          <svg class="w-8 h-8 text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 4.243a9 9 0 01-12.728 0m0 0l2.829-2.829m-2.829 2.829L3 21m2.828-5.657a5 5 0 010-7.072m0 0l2.829 2.829" />
          </svg>
          <h3 class="text-sm font-black text-white mb-1 font-heading">Simulation Temporarily Unreachable</h3>
          <p class="text-xs text-slate-400 max-w-sm mb-4">Please check your internet connection or reload the lab session.</p>
          <button type="button" onclick="const ifr = document.getElementById('phet-iframe'); ifr.src=ifr.dataset.src; document.getElementById('lab-fallback').classList.remove('show-fallback');" class="btn-enterprise-outline font-bold px-4 py-2 rounded-lg text-xs">
            Retry Loading Lab
          </button>
        </div>

      </div>
    </section>

    <!-- Moodle Course Overview Block Region -->
    <section role="region" aria-label="Enrolled Courses and Core Moodle Content" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-12 msa-dashboard-content overflow-x-auto">
        {{{ output.main_content }}}
      </div>
    </section>

  </main>

  <footer role="contentinfo" class="w-full bg-[#0F172A] text-slate-400 text-center text-xs py-4 border-t border-slate-800 mt-auto">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>

{{{ output.standard_end_of_body_html }}}
</body>
</html>
