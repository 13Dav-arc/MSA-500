<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard | MindStormer Academy</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    html, body {
      background-color: #F8FAFC !important;
      min-height: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      font-family: 'Inter', sans-serif;
    }
    h1, h2, h3, h4, .font-heading {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-enterprise {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 1rem;
      box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.05);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-enterprise:hover {
      border-color: #CBD5E1;
      box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.07);
    }
    .btn-enterprise-primary {
      background-color: #1D4ED8;
      color: #FFFFFF;
      border: 1px solid transparent;
      border-radius: 0.625rem;
      font-weight: 700;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      min-height: 44px;
      cursor: pointer;
      box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.08);
      transition: all 0.15s ease;
    }
    .btn-enterprise-primary:hover {
      background-color: #1E40AF;
      box-shadow: 0 4px 6px -1px rgba(29, 78, 216, 0.2);
    }
    .btn-enterprise-outline {
      background-color: #FFFFFF;
      color: #0F172A;
      border: 1px solid #CBD5E1;
      border-radius: 0.625rem;
      font-weight: 700;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      min-height: 44px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-enterprise-outline:hover {
      background-color: #F8FAFC;
      border-color: #94A3B8;
      color: #1D4ED8;
    }
    a:focus-visible,
    button:focus-visible,
    select:focus-visible {
      outline: 3px solid #1D4ED8 !important;
      outline-offset: 2px !important;
    }
    .simulation-embed-container {
      background-color: #0F172A;
      border: 1px solid #1E293B;
      border-top: 3px solid #1D4ED8;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.2);
    }
    .lab-iframe-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      min-height: 360px;
      background-color: #020617;
    }
    @supports not (aspect-ratio: 16 / 9) {
      .lab-iframe-wrapper {
        padding-bottom: 56.25%;
        height: 0;
      }
    }
    @media (max-width: 640px) {
      .lab-iframe-wrapper {
        min-height: 260px;
      }
    }
    .lab-iframe-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .lab-facade-cover {
      position: absolute;
      inset: 0;
      z-index: 20;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at center, #1E293B 0%, #0F172A 100%);
      padding: 2rem;
      text-align: center;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .lab-facade-cover.lab-loaded {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .lab-fallback-card {
      position: absolute;
      inset: 0;
      z-index: 25;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: #0F172A;
      padding: 2rem;
      text-align: center;
    }
    .lab-fallback-card.show-fallback {
      display: flex;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-[100dvh] overflow-x-hidden flex flex-col justify-between">

{{{ output.standard_top_of_body_html }}}

