{{! 
  @template theme_boost/signup
  MindStormer Global Academy (MSA-500) Enterprise Student Registration Template
}}
<!DOCTYPE html>
<html lang="en" style="background-color: #F8FAFC;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Registration | MindStormer Academy</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    html, body {
      background-color: #F8FAFC !important;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }
    h1, h2, h3, .font-heading {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .msa-page-wrapper {
      opacity: 0;
      animation: smoothPageGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothPageGlide {
      0% { opacity: 0; transform: translateY(4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .card-enterprise {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 1rem;
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
    }
    .btn-enterprise-primary {
      background-color: #1D4ED8;
      color: #FFFFFF;
      border-radius: 0.625rem;
      font-weight: 700;
      font-size: 0.875rem;
      letter-spacing: 0.02em;
      transition: all 0.15s ease;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
    }
    .btn-enterprise-primary:hover {
      background-color: #1E40AF;
      box-shadow: 0 4px 6px -1px rgba(29, 78, 216, 0.2);
    }
    .btn-enterprise-primary:focus-visible,
    .msa-input:focus-visible,
    a:focus-visible,
    button:focus-visible {
      outline: 3px solid #1D4ED8 !important;
      outline-offset: 2px !important;
    }
    .msa-form-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      color: #334155;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.375rem;
    }
    .msa-input {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 0.625rem;
      border: 1px solid #CBD5E1;
      font-size: 0.875rem;
      font-weight: 500;
      color: #0F172A;
      background-color: #FFFFFF;
      outline: none;
      transition: all 0.2s ease;
    }
    .msa-input:focus {
      border-color: #1D4ED8;
      box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.15);
    }
    .msa-select-custom {
      appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23334155' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 1rem center;
      background-size: 1.1em;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col justify-between">

{{{ output.standard_top_of_body_html }}}

<!-- WCAG 2.1 AA Skip to Main Content Bypass Link -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-[#1D4ED8] focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold focus:shadow-lg focus:outline-none">Skip to main content</a>

<div class="msa-page-wrapper flex-1 flex flex-col justify-between">

  <!-- Header Navigation Landmark -->
  <header role="banner" class="bg-white border-b border-slate-200 py-4 px-6">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3 focus-visible:rounded-lg" aria-label="MindStormer Global Academy Home">
        <div class="w-10 h-10 bg-[#0F172A] rounded-xl flex items-center justify-center text-white font-black text-base border border-slate-700 shadow-sm">MS</div>
        <span class="font-black text-base text-[#0F172A] font-heading">MAYND STORMIR <span class="text-[#1D4ED8]">ACADEMY</span></span>
      </a>
      <a href="{{{ config.wwwroot }}}/login/index.php" class="text-xs font-semibold text-slate-700 hover:text-[#1D4ED8] transition-colors focus-visible:rounded px-2 py-1">Already registered? Log in →</a>
    </div>
  </header>

  <!-- Form Section Landmark -->
  <main id="main-content" role="main" class="flex-1 flex items-center justify-center p-4 py-10">
    <div class="w-full max-w-2xl card-enterprise rounded-2xl p-6 sm:p-10">
      
      <div class="text-center mb-8">
        <div class="inline-flex p-3 bg-blue-50 text-[#1D4ED8] rounded-xl font-bold mb-3 shadow-sm" aria-hidden="true">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-[#0F172A] tracking-tight font-heading">Create Student Account</h1>
        <p class="text-xs sm:text-sm font-medium text-slate-600 mt-1">Enroll into your assigned K–8 / JSS STEM curriculum and assessment track</p>
      </div>

      {{#error}}
      <div class="flex items-center gap-2 p-3.5 mb-6 text-xs font-bold text-red-800 bg-red-50 border border-red-300 rounded-lg" role="alert" aria-live="assertive">
        <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{{error}}</span>
      </div>
      {{/error}}

      <form action="{{{ signupurl }}}" method="post" id="signup" class="space-y-5" novalidate>
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="account_type" value="student">

        <!-- Grid: Account Credentials -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4">
          <div>
            <label for="username" class="msa-form-label">Username</label>
            <input type="text" id="username" name="username" required aria-required="true" placeholder="e.g. alex2026" class="msa-input" autocomplete="username">
          </div>
          <div>
            <label for="email" class="msa-form-label">Student Email Address</label>
            <input type="email" id="email" name="email" required aria-required="true" placeholder="alex@mindstormer.com" class="msa-input" autocomplete="email">
          </div>
        </div>

        <!-- Password Field with Visibility Toggle & Accessible Checklist -->
        <div class="relative">
          <label for="student_password" class="msa-form-label">Create Password</label>
          <div class="relative">
            <input type="password" id="student_password" name="password" required aria-required="true" aria-describedby="password-rules" placeholder="Enter strong password" autocomplete="new-password" class="msa-input pr-11">
            <button type="button" data-toggle-password="student_password" aria-label="Show password" aria-pressed="false" class="absolute right-3 top-[10px] text-slate-500 hover:text-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg p-1.5 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>

          <!-- Dynamic Real-Time Password Validation Pills -->
          <div id="password-rules" role="region" aria-label="Password Requirements" class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-2.5" aria-live="polite">
            <div id="rule-length" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-[11px] font-semibold border border-slate-200 transition-colors">
              <span class="status-icon" aria-hidden="true">○</span> <span>8+ Chars</span>
            </div>
            <div id="rule-upper" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-[11px] font-semibold border border-slate-200 transition-colors">
              <span class="status-icon" aria-hidden="true">○</span> <span>1 Uppercase</span>
            </div>
            <div id="rule-num" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-[11px] font-semibold border border-slate-200 transition-colors">
              <span class="status-icon" aria-hidden="true">○</span> <span>1 Number</span>
            </div>
            <div id="rule-spec" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-[11px] font-semibold border border-slate-200 transition-colors">
              <span class="status-icon" aria-hidden="true">○</span> <span>1 Symbol</span>
            </div>
          </div>
        </div>

        <!-- Grid: Names -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-4">
          <div>
            <label for="firstname" class="msa-form-label">First Name</label>
            <input type="text" id="firstname" name="firstname" required aria-required="true" placeholder="Alex" autocomplete="given-name" class="msa-input">
          </div>
          <div>
            <label for="lastname" class="msa-form-label">Last Name</label>
            <input type="text" id="lastname" name="lastname" required aria-required="true" placeholder="O." autocomplete="family-name" class="msa-input">
          </div>
        </div>

        <!-- Grid: Location & Track -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-4 gap-y-4">
          <div>
            <label for="city" class="msa-form-label">City / Town</label>
            <input type="text" id="city" name="city" placeholder="Lagos" autocomplete="address-level2" class="msa-input">
          </div>
          <div>
            <label for="country" class="msa-form-label">Country</label>
            <select id="country" name="country" class="msa-input msa-select-custom cursor-pointer" aria-label="Select Country">
              <option value="NG" selected>Nigeria</option>
              <option value="GH">Ghana</option>
              <option value="GB">United Kingdom</option>
              <option value="US">United States</option>
              <option value="CA">Canada</option>
            </select>
          </div>
          <div>
            <label for="grade" class="msa-form-label">Academic Track</label>
            <select id="grade" name="grade" required aria-required="true" class="msa-input msa-select-custom cursor-pointer" aria-label="Select Grade Level Track">
              <optgroup label="Foundational Tier (Ages 5–8)">
                <option value="g1">Grade 1 (Foundational)</option>
                <option value="g2">Grade 2 (Foundational)</option>
                <option value="g3">Grade 3 (Foundational)</option>
              </optgroup>
              <optgroup label="Intermediate Tier (Ages 9–11)">
                <option value="g4">Grade 4 (Intermediate)</option>
                <option value="g5">Grade 5 (Intermediate)</option>
                <option value="g6">Grade 6 (Intermediate)</option>
              </optgroup>
              <optgroup label="Junior Secondary Tier (Ages 12–14)">
                <option value="g7" selected>Grade 7 (Junior Sec 1)</option>
                <option value="g8">Grade 8 (Junior Sec 2)</option>
                <option value="g9">Grade 9 (Junior Sec 3)</option>
              </optgroup>
            </select>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitbtn" class="w-full btn-enterprise-primary text-white font-bold py-3.5 rounded-lg text-sm uppercase tracking-wider mt-4 cursor-pointer">
          Complete Student Registration
        </button>
      </form>

      <!-- Bottom Navigation Footer -->
      <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs font-semibold text-slate-600">
        <div>Parent or Guardian? <a href="{{{ config.wwwroot }}}/login/signup.php?role=parent" class="text-emerald-700 hover:text-emerald-800 hover:underline focus-visible:rounded px-1">Guardian Portal Registration</a></div>
        <div><a href="{{{ config.wwwroot }}}/login/index.php" class="text-[#1D4ED8] hover:text-[#1E40AF] hover:underline focus-visible:rounded px-1">Return to Login</a></div>
      </div>
    </div>
  </main>

  <footer role="contentinfo" class="bg-[#0F172A] text-slate-400 text-center text-xs py-4 border-t border-slate-800">
    © 2026 Maynd Stormir Inc. All rights reserved.
  </footer>

</div>

<script src="assets/js/form-validation.js" defer></script>

{{{ output.standard_end_of_body_html }}}
</body>
</html>
